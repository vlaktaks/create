#!/usr/bin/env bash

language=$1
create_file=$2
shebang=

if [[ -z "$language" || -z "$create_file" ]]; then
  echo "Usage: create --bash|--python|--sh filename"
  exit 1
fi

if [[ -e "$create_file" ]]; then
  echo "File '$create_file' already exists."
  exit 1
fi

case "$language" in
--bash)
  shebang='#!/usr/bin/env bash'
  ;;
--python)
  shebang='#!/usr/bin/env python3'
  ;;
--sh)
  shebang='#!/bin/sh'
  ;;
*)
  echo "Unknown language: $language"
  exit 1
  ;;
esac

printf '%s\n' "$shebang" >"$create_file" || exit 1
chmod +x "$create_file"

echo "Created '$create_file' successfully."
